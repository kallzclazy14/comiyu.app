rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validProfile(uid) {
      return signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.userId is string
        && request.resource.data.userId.matches('^08[0-9]{10}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if validProfile(uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    match /user_lookup/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId.matches('^08[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/user_lookup/$(userId));
      // Nomor yang sudah terdaftar tidak dapat diambil alih pengguna lain.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
      match /messages/{messageId} {
        function isMember() {
          return signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['senderUid', 'senderName', 'body', 'sentAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.sentAt is timestamp;
        // Retry dari antrean lokal boleh mengulang dokumen identik (idempotensi).
        allow update: if isMember() && resource.data == request.resource.data;
        allow delete: if false;
      }
    }
  }
}
